{
  "name": "governance-harness",
  "private": true,
  "version": "1.7.4",
  "description": "AI governance, risk and assurance harness: a gated board where agents draft and people decide.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/server",
    "db:reset": "npm run db:reset -w apps/server",
    "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/web",
    "smoke": "node scripts/smoke.mjs",
    "test:agents": "node scripts/agents-test.mjs",
    "test:grounding": "node scripts/grounding-test.mjs",
    "test:verifier": "node scripts/verifier-test.mjs",
    "test:assistant": "node scripts/assistant-test.mjs",
    "test:operations": "node scripts/operations-test.mjs",
    "test:v11": "node scripts/v11-test.mjs",
    "test:v12": "node scripts/v12-test.mjs",
    "versions": "node scripts/version.mjs",
    "demo": "node scripts/demo-data.mjs",
    "demo:topup": "node scripts/demo/topup-v174.mjs",
    "demo:build": "node scripts/demo/library.mjs build",
    "demo:list": "node scripts/demo/library.mjs list",
    "demo:load": "node scripts/demo/library.mjs load",
    "demo:save": "node scripts/demo/library.mjs save",
    "manual": "node scripts/build-manual.mjs",
    "lessons": "node scripts/lessons-index.mjs --write",
    "check:lessons": "node scripts/lessons-index.mjs && node scripts/checks/lesson-checks.mjs",
    "release": "node scripts/release.mjs",
    "test:v15": "node scripts/v15-test.mjs",
    "test:v16": "node scripts/v16-test.mjs",
    "test:rag": "node scripts/rag-test.mjs",
    "test:v17": "node scripts/v17-test.mjs",
    "test:v173": "node scripts/v173-test.mjs",
    "test:v174": "node scripts/v174-test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "marked": "^12.0.2"
  },
  "engines": {
    "node": ">=20.12"
  }
}
