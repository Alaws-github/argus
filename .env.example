# Copy to .env. Everything here is optional.

# Used by the Anthropic provider when it has no key saved on the Models page.
ANTHROPIC_API_KEY=

# Encrypts provider API keys at rest: 64 hex characters (32 bytes).
# If unset, a key is generated once into data/secret.key. Back that file up.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Use a real Postgres instead of the embedded one in ./data
# DATABASE_URL=postgres://user:password@localhost:5432/governance

PORT=4300

# Set to true behind HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false
